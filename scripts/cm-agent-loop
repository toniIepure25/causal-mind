#!/usr/bin/env bash
set -euo pipefail

CM_BASE_REPO="${CM_BASE_REPO:-/home/jovyan/work/causal-mind-v2}"
CM_REPO="${CM_REPO:-$CM_BASE_REPO}"

cd "$CM_REPO"
export PYTHONPATH="$CM_REPO/src:${PYTHONPATH:-}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/home/jovyan/work/.uv-cache-jovyan}"
export GIT_CONFIG_COUNT="${GIT_CONFIG_COUNT:-1}"
export GIT_CONFIG_KEY_0="${GIT_CONFIG_KEY_0:-safe.directory}"
export GIT_CONFIG_VALUE_0="${GIT_CONFIG_VALUE_0:-*}"
exec "$CM_BASE_REPO/.venv/bin/python" -m causal_mind.cli agent loop "$@"
