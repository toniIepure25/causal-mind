{
  "$schema": "https://opencode.ai/config.json",
  "model": "runai/qwen38-27b12",
  "small_model": "runai/qwen38-27b12",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "external_directory": "deny",
    "question": "deny",
    "doom_loop": "deny",
    "skill": "deny",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pytest*": "allow",
      "ruff*": "allow",
      "uv run pytest*": "allow",
      "uv run ruff*": "allow",
      "python*": "allow",
      "rm *": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "kubectl *": "deny"
    }
  },
  "agent": {
    "smoke": {
      "description": "No-tool smoke test agent.",
      "model": "runai/qwen38-27b12",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false,
        "patch": false,
        "read": false,
        "grep": false,
        "glob": false,
        "list": false
      },
      "permission": {
        "*": "deny",
        "question": "deny"
      }
    },
    "orchestrator": {
      "description": "Principal research engineer: task DAG, gates, merges, claims registry.",
      "model": "runai/qwen38-27b12"
    },
    "researcher": {
      "description": "Scientific researcher: literature, dataset audits, novelty matrix.",
      "model": "runai/qwen38-27b12"
    },
    "data-engineer": {
      "description": "Data/neuroimaging engineer: acquisition, manifests, loaders, alignment.",
      "model": "runai/qwen38-27b12"
    },
    "forecasting-engineer": {
      "description": "Forecasting/ML engineer: thought state, baselines, temporal models.",
      "model": "runai/qwen38-27b12"
    },
    "causal-engineer": {
      "description": "Causal inference/statistics engineer: DAGs, identification, gates.",
      "model": "runai/qwen38-27b12"
    },
    "reviewer": {
      "description": "Validation/red-team reviewer. Read-mostly. BLOCK authority.",
      "model": "runai/qwen38-27b12",
      "tools": {
        "write": false,
        "edit": false,
        "patch": false,
        "bash": true,
        "read": true,
        "grep": true,
        "glob": true,
        "list": true
      },
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "grep *": "allow",
          "rg *": "allow"
        }
      }
    }
  },
  "provider": {
    "runai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Run:ai Qwen",
      "options": {
        "baseURL": "http://127.0.0.1:18000/v1",
        "apiKey": "local-port-forward",
        "timeout": 900000,
        "headerTimeout": 180000,
        "chunkTimeout": 180000
      },
      "models": {
        "qwen38-27b12": {
          "id": "Qwen/Qwen3.8-27B-FP8",
          "name": "Qwen3.8-27B-FP8",
          "tool_call": true,
          "attachment": false,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning"
          },
          "temperature": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  }
}
